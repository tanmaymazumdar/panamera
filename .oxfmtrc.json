{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "endOfLine": "lf",
  "jsxSingleQuote": true,
  "printWidth": 120,
  "semi": false,
  "singleQuote": true,
  "sortImports": {
    "groups": [["builtin", "subpath"], ["external"], ["parent", "sibling", "index"], ["type", "style"]]
  },
  "sortTailwindcss": {
    "attributes": ["class", "className"],
    "functions": ["clsx", "cn", "cva", "tw"]
  },
  "tabWidth": 2,
  "trailingComma": "all",
  "ignorePatterns": []
}
